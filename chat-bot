# Обработчики основных функций
@bot.message_handler(func=lambda message: message.text == "Сравнить программы" and user_states.get(message.chat.id, {}).get("state") == "main")
def compare_programs(message):
    response = " Сравнение программ:\n\n"
    
    # Основная информация
    response += " Основная информация:\n"
    for key in ["institute", "form", "duration", "language", "price", "dormitory", "military_center", "accreditation"]:
        ai_val = programs_data["ai"][key]
        ai_product_val = programs_data["ai_product"][key]
        response += f"- {key.replace('_', ' ').title()}: {ai_val} / {ai_product_val}\n"
    
    # Особенности
    response += "\n Особенности:\n"
    response += f"- Искусственный интеллект: {programs_data['ai']['features']}\n"
    response += f"- Управление ИИ-продуктами: {programs_data['ai_product']['features']}\n"
    
    # Направления подготовки
    response += "\n Направления подготовки:\n"
    for code, spec in programs_data["ai"]["specialties"].items():
        response += f"- {code} {spec['name']}:\n"
        response += f"  Бюджет: {spec['budget']} / "
        if code in programs_data["ai_product"]["specialties"]:
            response += f"{programs_data['ai_product']['specialties'][code]['budget']}\n"
        else:
            response += "-\n"
    
    bot.send_message(message.chat.id, response)

